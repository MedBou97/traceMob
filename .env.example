# Copy to .env on the VPS and replace the password with a unique secret.
POSTGRES_USER=tracemob
POSTGRES_PASSWORD=replace-with-64-character-hex-secret
POSTGRES_DB=tracemob

# Keep loopback binding for a safer default. Set to 0.0.0.0 only when
# intentionally exposing the API on the VPS public interface.
API_BIND_ADDRESS=0.0.0.0
CORS_ORIGIN=http://localhost:5173
